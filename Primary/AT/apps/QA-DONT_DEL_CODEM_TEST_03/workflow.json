        "fileName" : null,
        "sparkScript" : "from pyspark.sql import SparkSession\nfrom pyspark.sql.functions import col, to_date, date_format\n\n# -------------------------\n# Parameters (from pipeline)\n# -------------------------\nfrom_date = @fromDate\nend_date   = @toDate\ndates      = [@datesToProcess]\n\nprint(f\"CODE_MANAGED from_date={from_date}, end_date={end_date}, dates={dates}\")\n\n# -------------------------\n# Write mode switch\n# \"DROP_REPLACE\" → drop table, recreate and insert\n# \"APPEND\"       → insert into existing table\n# -------------------------\nWRITE_MODE = \"DROP_REPLACE\"\n\n# -------------------------\n# Helper\n# -------------------------\ndef strip_epoch(d):\n    return d.split(\"_\")[0] if \"_\" in d else d\n\ndates_to_process = sorted(dates)[:3]\nclean_dates = [strip_epoch(d) for d in dates_to_process]\nprint(f\"Processing only first 3 dates: {clean_dates}\")\n\n# -------------------------\n# Read CSV from GCS\n# -------------------------\nfile_path = \"s3://syntasa-qa/qa/adhoc/puneet/File (2).csv\"\n\ndf = spark.read \\\n    .option(\"header\", True) \\\n    .option(\"inferSchema\", True) \\\n    .option(\"delimiter\", \",\") \\\n    .csv(file_path)\n\n# Convert file_date from DD-MM-YYYY to YYYY-MM-DD\ndf = df.withColumn(\"file_date\", date_format(to_date(col(\"file_date\"), \"dd-MM-yyyy\"), \"yyyy-MM-dd\"))\n\ndf = df.filter(\n    (col(\"file_date\") >= from_date) &\n    (col(\"file_date\") <= end_date)\n)\n\n\nprint(\"Input Data:\")\ndf.show()\n\n# -------------------------\n# Write to Event Store\n# -------------------------\nif WRITE_MODE == \"DROP_REPLACE\":\n    print(\"Mode: DROP_REPLACE — dropping existing table before write\")\n    spark.sql(\"DROP TABLE IF EXISTS @OutputTable1\")\n    writeToEventStore(df, \"@OutputTable1\", 1, \"file_date\")\nelif WRITE_MODE == \"APPEND\":\n    print(\"Mode: APPEND — appending to existing table\")\n    writeToEventStore(df, \"@OutputTable1\", 1, \"file_date\")\nelse:\n    raise ValueError(f\"Unknown WRITE_MODE: {WRITE_MODE}. Use 'DROP_REPLACE' or 'APPEND'.\")\n\nprint(\"Write complete\")\n ",
