        "language" : "SCALA",
        "fileName" : null,
        "sparkScript" : "import org.apache.spark.sql.functions._\n\n// Create a DataFrame from the rate stream\n// `rowsPerSecond` specifies the rate at which data is generated\nval rateStreamDF = spark.readStream\n  .format(\"rate\")\n  .option(\"rowsPerSecond\", 5)  // Generate 5 rows per second\n  .option(\"rampUpTime\", 1)     // Time to ramp up to the full rate\n  .load()\n\n// Add some processing: for example, calculate the modulus of the value\nval processedDF = rateStreamDF.withColumn(\"mod_value\", $\"value\" % 10)\n\n// Start the stream and output the results to the console\nval query = processedDF.writeStream\n  .outputMode(\"append\")\n  .format(\"console\")\n  .start()\n\n// Await termination with a timeout of 5 minutes (300,000 milliseconds)\nquery.awaitTermination(5 * 60 * 1000)  // 5 minutes in milliseconds\n\n// Once the timeout expires, stop the query\nquery.stop()\nprintln(\"Streaming query stopped after 5 minutes.\")\n\n",
