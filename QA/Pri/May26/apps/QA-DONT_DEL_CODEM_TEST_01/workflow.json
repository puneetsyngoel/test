        "sparkScript" : "from pyspark.sql import SparkSession\nfrom pyspark.sql.functions import col, to_date, date_format\n\n# -------------------------\n# Parameters (from pipeline)\n# -------------------------\nfrom_date = @fromDate\nend_date = @toDate\ndates = [@datesToProcess]\n\nprint(f\"CODE_MANAGED from_date={from_date}, end_date={end_date}, dates={dates}\")\n\n# -------------------------\n# Helper function\n# -------------------------\ndef strip_epoch(d):\n    return d.split(\"_\")[0] if \"_\" in d else d\n\n# Take first 3 dates (same as your logic)\ndates_to_process = sorted(dates)[:3]\nclean_dates = [strip_epoch(d) for d in dates_to_process]\n\nprint(f\"Processing only first 3 dates: {clean_dates}\")\n\n# -------------------------\n# Initialize Spark\n# -------------------------\nspark = SparkSession.builder.appName(\"ReadCSVFile\").getOrCreate()\n\n# -------------------------\n# Read CSV from GCS\n# -------------------------\nfile_path = \"s3://syntasa-qa/qa/adhoc/puneet/File (2).csv\"\n\ndf = spark.read \\\n    .option(\"header\", True) \\\n    .option(\"inferSchema\", True) \\\n    .option(\"delimiter\", \",\") \\\n    .csv(file_path)\n\n# Convert DD-MM-YYYY → YYYY-MM-DD\ndf = df.withColumn(\"file_date\", date_format(to_date(col(\"file_date\"), \"dd-MM-yyyy\"), \"yyyy-MM-dd\"))\n\nprint(\"Input Data:\")\ndf.show()\n\n# -------------------------\n# Filter based on dates\n# (Assuming CSV has 'file_date' column)\n# -------------------------\n#df_filtered = df.filter(col(\"file_date\").isin(clean_dates))\n\n#print(\"Filtered Data:\")\n#df_filtered.show()\n\n# -------------------------\n# Write to Event Store\n# -------------------------\nwriteToEventStore(df, \"@OutputTable1\", 1, \"file_date\")\n\nprint(\"Write complete\")",
