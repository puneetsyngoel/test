      "parameters" : {
        "language" : "SCALA",
        "fileName" : "SparkScript.scala",
        "sparkScript" : "// demo data - 08/28/2018\r\n\r\nval dataset =spark.createDataFrame(Seq((0, \"Cricket\"), (1, \"Volleyball\"))).toDF(\"id\", \"sport\")\r\n\r\nval upper: String => String = _.toUpperCase\r\n\r\nval upperUDF = udf(upper)\r\n\r\nval newDataSet = dataset.\r\nwithColumn(\r\n\"capSport\",\r\nupperUDF(dataset(\"sport\")\r\n)\r\n)\r\nnewDataSet.show()\r\nsql(\"select date_sub(current_timestamp(), 1)\").show()\r\n\r\nspark.sql(\"create table if not exists @OutputTable1 (id String, value double) stored as parquet location @location\")\r\nsql(s\"insert into @OutputTable1 values('test_id',2.0)\")",
