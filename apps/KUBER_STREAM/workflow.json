    "id" : "75f47457-a471-4ade-b00f-b008ce8a299f",
    "name" : "Spark Stream Sample Rate Source",
    "appNodeId" : "ebd8e4f5-94fc-4308-bae3-7d48880a3532",
    "workflowId" : "cd3df99d-6389-4f29-a8b6-53061e416b4b",
    "objectTypeKey" : null,
