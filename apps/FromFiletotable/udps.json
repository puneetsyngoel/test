          "sparkScript" : "import subprocess\nimport sys\ndef installpip():\n    subprocess.call([sys.executable, \"-m\", \"easy_install\", \"pip\"])\ndef install(package):\n    subprocess.call([sys.executable, \"-m\", \"pip\", \"install\", package])\n     \ninstallpip()\ninstall(\"git+http://github.com/SaturnFromTitan/adobe_analytics.git\")\n\nfrom adobe_analytics import Client, ReportDefinition\nimport time\nfrom datetime import datetime\n\np_word = synutils.connection().getConnectionParam(\"@InputConnection1\", \"password\")\nusername = synutils.connection().getConnectionParam(\"@InputConnection1\", \"userName\")\n\nclient = Client(username, p_word)\n\nsuites = client.suites()\n\nrsid = \"@rsid\"\nmets = \"@metrics\".split(\",\")\ndimensionList = \"@dimensions\".split(\",\")\nsegs = \"@segments\".split(\",\")\ngranularity = \"@granularity\" # [\"hour\", \"day\", \"week\", \"month\", \"quarter\", \"year\"]\n\nif segs == [\" \"]:\n\tsegs = None\n\nsuite = suites[rsid]\n\ndims = []\nfor dim in dimensionList:\n    dims.append({\"id\":dim,\"top\":50000})\nfromDate = @fromDate[0:10]\ntoDate = @toDate[0:10]\n\nreport_def = ReportDefinition(\n    dimensions = dims,\n    metrics = mets,\n\tsegments = segs,\n    date_from = fromDate,\n    date_to = toDate,\n    granularity = granularity\n)\n\ndf = suite.download(report_def)\n\nimport re\ndf.rename(columns=lambda h: re.sub(\"\\W|^[0-9]\", \"\", h.replace(\" \", \"\")), inplace=True)\n\nsparkDf = spark.createDataFrame(df.astype(str))\n\nwriteToEventStore(sparkDf, \"@OutputTable1\")",
